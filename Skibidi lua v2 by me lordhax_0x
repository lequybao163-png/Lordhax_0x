-- Xử lý nút FSA (mới thêm)
local function FSAScript()
	local script = Instance.new('LocalScript', FSABtn)
	local Outputithink = script.Parent.Parent.Parent.Parent.Outputithink
	script.Parent.MouseButton1Click:Connect(function()
		local success, err = pcall(function()
			loadstring(game:HttpGet("https://pastefy.app/zSqO6XtZ/raw"))()
		end)
		if success then
			Outputithink.Text = "[IDE]: Executed FSA Script Successfully!"
		else
			Outputithink.Text = "[IDE Error]: " .. tostring(err)
		end
	end)
end
coroutine.wrap(FSAScript)()

-- Xử lý nút Knife
local function KnifeScript()
	local script = Instance.new('LocalScript', KnifeBtn)
	local Outputithink = script.Parent.Parent.Parent.Parent.Outputithink
	script.Parent.MouseButton1Click:Connect(function()
		local success, err = pcall(function()
			local pl = game.Players.LocalPlayer
			local ch = pl.Character or pl.CharacterAdded:Wait()
			ch.Head.Transparency = 1 
			if ch.Head:FindFirstChild("face") then ch.Head.face:Destroy() end
			if ch.Head:FindFirstChild("Sound") then ch.Head.Sound:Destroy() end
			
			local hb = Instance.new("HopperBin", pl.Backpack)
			hb.Name = "Knife"
			
			local k3
			
			hb.Selected:Connect(function(mouse)
				local animation = Instance.new("Animation")
				animation.Name = "SlashAnim"
				animation.AnimationId = "http://www.roblox.com/Asset?ID=94160581"
				local animTrack = ch.Humanoid:LoadAnimation(animation)
				animTrack:Play()
				
				local mof = Instance.new("Model", ch)
				local k = Instance.new("Part", mof) 
				k.Name = "waf" 
				k.CanCollide = false
				k.BrickColor = BrickColor.new("Really black")
				k.formFactor = "Custom" 
				k.Size = Vector3.new(.31, .31, 1) 
				k.TopSurface = 0 
				k.BottomSurface = 0 
				k.Transparency = 0 
				k:BreakJoints() 
				local kWeld = Instance.new("Weld") 
				kWeld.Parent = k
				kWeld.Part0 = ch['Right Arm']
				kWeld.Part1 = k
				kWeld.C0 = CFrame.new(0,-1.1,0)
				
				local k2 = Instance.new("Part", mof) 
				k2.Name = "waf" 
				k2.CanCollide = false
				k2.formFactor = "Custom" 
				k2.Size = Vector3.new(.2, .3, 1) 
				k2.TopSurface = 0 
				k2.BottomSurface = 0 
				k2.Transparency = 0 
				k2:BreakJoints() 
				local k2Weld = Instance.new("Weld") 
				k2Weld.Parent = k2
				k2Weld.Part0 = k
				k2Weld.Part1 = k2
				k2Weld.C0 = CFrame.new(0,0,-.75)
				
				k3 = Instance.new("WedgePart", mof) 
				k3.Name = "waf" 
				k3.CanCollide = false
				k3.formFactor = "Custom" 
				k3.Size = Vector3.new(.1, .3, .3) 
				k3.TopSurface = 0 
				k3.BottomSurface = 0 
				k3.Transparency = 0 
				k3:BreakJoints() 
				local k3Weld = Instance.new("Weld") 
				k3Weld.Parent = k3
				k3Weld.Part0 = k
				k3Weld.Part1 = k3
				k3Weld.C0 = CFrame.new(0,0,-1.4) * CFrame.Angles(0, 0, math.pi/1)
				
				mouse.Button1Down:Connect(function()
					local h = Instance.new("Part", mof) 
					h.CanCollide = false
					h.Size = Vector3.new(1, 1, 1) 
					h.Transparency = 1 
					h:BreakJoints() 
					local hWeld = Instance.new("Weld") 
					hWeld.Parent = h
					hWeld.Part0 = k3
					hWeld.Part1 = h
					
					local function touch(hit) 
						if hit.Parent:FindFirstChild("Humanoid") ~= nil then 
							hit.Parent.Humanoid:TakeDamage(10)
						end
					end
					h.Touched:Connect(touch)
					
					local slashAnim = Instance.new("Animation")
					slashAnim.Name = "SlashAnim"
					slashAnim.AnimationId = "http://www.roblox.com/Asset?ID=94161088"
					local slashTrack = ch.Humanoid:LoadAnimation(slashAnim)
					slashTrack:Play()
					game.Debris:AddItem(h, 1)
				end)
				
				local vState = false
				mouse.KeyDown:Connect(function(kKey)
					if string.byte(kKey) == 113 then
						vState = not vState
						if vState then
							hb.Name = "bad"
							task.wait(.5)
							hb.Name = "Dark_Movement"
							
							local ef = Instance.new("Part", ch) 
							ef.CanCollide = false
							ef.BrickColor = BrickColor.new("Royal purple")
							local m = Instance.new("SpecialMesh", ef)
							m.MeshId = 'http://www.roblox.com/Asset?ID=9982590'
							m.Scale = Vector3.new(2,.1,2)
							ef.Size = Vector3.new(1, 1, 1) 
							ef.Transparency = 0 
							ef:BreakJoints() 
							local efWeld = Instance.new("Weld") 
							efWeld.Parent = ef
							efWeld.Part0 = ch.Torso
							efWeld.Part1 = ef
							
							coroutine.resume(coroutine.create(function()
