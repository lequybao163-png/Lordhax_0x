local function PeeScript()
	local script = Instance.new('LocalScript', PeeBtn)
	local Outputithink = script.Parent.Parent.Parent.Parent.Outputithink
	script.Parent.MouseButton1Click:Connect(function()
		local success, err = pcall(function()
			local Player = game.Players.LocalPlayer
			local Character = Player.Character or Player.CharacterAdded:Wait()
			local Head = Character:WaitForChild("Head")
			local Torso = Character:FindFirstChild("Torso") or Character:WaitForChild("UpperTorso")

			local function Weld(x, y)
				local W = Instance.new("Weld")
				W.Part0 = x
				W.Part1 = y
				local CJ = CFrame.new(x.Position)
				local C0 = x.CFrame:inverse() * CJ
				local C1 = y.CFrame:inverse() * CJ
				W.C0 = C0
				W.C1 = C1
				W.Parent = x
			end

			local Breath = Instance.new("Part")
			Breath.Name = "Breath"
			Breath.Parent = Head
			Breath.CFrame = Torso.CFrame * CFrame.new(0, -1, 0)
			Breath.CanCollide = false
			Breath.Transparency = 1
			Breath.Size = Vector3.new(0.05, 0.05, 0.05)

			local Air = Instance.new("ParticleEmitter")
			Air.Parent = Breath
			Air.EmissionDirection = Enum.NormalId.Front
			Air.Rate = 500
			Air.Color = ColorSequence.new(Color3.new(1, 1, 0), Color3.new(1, 1, 0))
			Air.Speed = NumberRange.new(15, 15)
			Air.Acceleration = Vector3.new(0, -25, 0)
			Air.Size = NumberSequence.new(0.1, 0.1)
			Air.Lifetime = NumberRange.new(0.5, 0.5)
			Air.Transparency = NumberSequence.new(0, 0)

			local Pees = Instance.new("Sound")
			Pees.Parent = Torso
			Pees.SoundId = "rbxassetid://258063615"
			Pees.Looped = true
			Pees.Volume = 0.8
			Pees:Play()

			Weld(Head, Breath)

			task.spawn(function()
				while true do
					local pee = Instance.new("Part")
					pee.Name = "Pee"
					pee.Parent = workspace
					game:GetService("Debris"):AddItem(pee, 10)
					pee.CFrame = Torso.CFrame * CFrame.new(0, -2.9, -6)
					pee.CanCollide = false
					pee.BrickColor = BrickColor.new("New Yeller")
					pee.Transparency = 0.4
					pee.Size = Vector3.new(1.5, 0.01, 1.5)
					pee.Anchored = true

					local pmesh = Instance.new("SpecialMesh")
					pmesh.Parent = pee
					pmesh.Scale = Vector3.new(1, 0.1, 1)
					pmesh.MeshType = Enum.MeshType.Sphere

					for size = 1.5, 2, 0.1 do
						pee.Size = Vector3.new(size, 0.01, size)
						task.wait(0.05)
					end

					task.wait(1 / 60)
				end
			end)
		end)
		if success then
			Outputithink.Text = "[IDE]: Executed Pee Script!"
		else
			Outputithink.Text = "[IDE Error]: " .. tostring(err)
		end
	end)
end
coroutine.wrap(PeeScript)()

