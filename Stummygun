-- 4. Làm tàng hình nút Aim (giữ nguyên các nút khác & tướng chạy)
task.spawn(function()
	local targetName = "aim"
	local player = game:GetService("Players").LocalPlayer
	local guiRoot = player:WaitForChild("PlayerGui")

	local function makeInvisible(obj)
		pcall(function()
			if obj:IsA("TextButton") or obj:IsA("TextLabel") then
				obj.TextTransparency = 1
				obj.TextStrokeTransparency = 1
			end
			if obj:IsA("ImageButton") or obj:IsA("ImageLabel") then
				obj.ImageTransparency = 1
			end
			if obj:IsA("GuiObject") then
				obj.BackgroundTransparency = 1
				obj.Active = false
			end
		end)
	end

	for i = 1, 10 do
		task.wait(0.5)
		for _, obj in ipairs(guiRoot:GetDescendants()) do
			if obj:IsA("TextButton") or obj:IsA("TextLabel") then
				local cleanText = string.lower(string.match(obj.Text or "", "^%s*(.-)%s*$"))
				if cleanText == targetName then
					makeInvisible(obj)
				end
			end
		end
	end
end)
